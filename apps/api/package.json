{
  "name": "@afristage/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "lint": "tsc --noEmit -p tsconfig.build.json",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "test:concurrency": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --testRegex '.*\\.int-spec\\.ts$' --runInBand",
    "deadcode": "knip"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/platform-socket.io": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "^5.19.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.5",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "livekit-server-sdk": "^2.19.1",
    "otplib": "^12.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.6",
    "@nestjs/schematics": "12.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.9.0",
    "jest": "30.5.2",
    "knip": "^6.37.0",
    "prisma": "^5.19.1",
    "ts-jest": "29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "6.0.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
