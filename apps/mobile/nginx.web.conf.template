# Rendered by the nginx image's envsubst (only ${PORT} is substituted; nginx's
# own $uri is left alone because `uri` is not an env var). Serves the Flutter web
# build, answers the shared railway.toml healthcheck, and falls back to index.html.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Shared railway.toml sets healthcheckPath=/api/health for every service.
    location = /api/health {
        add_header Content-Type application/json;
        # `commit` matches the api and web contract so a deploy can be VERIFIED
        # rather than inferred from a 200. nginx's entrypoint runs envsubst over
        # this template at CONTAINER START, so the value comes from the runtime
        # environment — the Railway service variable — not from the image. The
        # build arg below is only a local fallback.
        return 200 '{"status":"ok","service":"flutter-web","commit":"${GIT_SHA}"}';
    }

    # A deployed fix that a browser never fetches is not deployed.
    #
    # Nothing here sent Cache-Control at all, so browsers fell back to HEURISTIC
    # freshness — roughly a tenth of the file's age — and served main.dart.js
    # from disk without asking. Flutter compounds it: index.html registers a
    # service worker that caches the bundle against its own version manifest, so
    # a stale index.html means the app never learns a newer build exists. On
    # 2026-09-23 the deployed bundle demonstrably contained a fix the browser
    # was still not running.
    #
    # `no-cache` does NOT mean "do not store" — it means "revalidate before
    # use". With the ETag already being sent, an unchanged file costs a 304 and
    # no body. These are the entry points only; Flutter does not content-hash
    # main.dart.js, so it cannot be treated as immutable.
    location ~ ^/(index\.html|flutter_service_worker\.js|version\.json|main\.dart\.js|flutter\.js|flutter_bootstrap\.js)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Flutter web uses hash routing by default, but keep an SPA fallback for safety.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
