# Rendered by the nginx image's envsubst (only ${PORT} is substituted; nginx's
# own $uri is left alone because `uri` is not an env var). Serves the Flutter web
# build, answers the shared railway.toml healthcheck, and falls back to index.html.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Shared railway.toml sets healthcheckPath=/api/health for every service.
    location = /api/health {
        add_header Content-Type application/json;
        # `commit` matches the api and web contract so a deploy can be VERIFIED
        # rather than inferred from a 200. nginx's entrypoint runs envsubst over
        # this template at CONTAINER START, so the value comes from the runtime
        # environment — the Railway service variable — not from the image. The
        # build arg below is only a local fallback.
        return 200 '{"status":"ok","service":"flutter-web","commit":"${GIT_SHA}"}';
    }

    # Flutter web uses hash routing by default, but keep an SPA fallback for safety.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
